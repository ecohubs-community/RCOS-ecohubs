---
import BaseLayout from '../layouts/BaseLayout.astro';
import DashboardTiles from '../components/DashboardTiles.astro';
import FAQ from '../components/FAQ.svelte';
import { getEntry } from 'astro:content';

const faqEntry = await getEntry('faq', 'faq');
const faqItems = faqEntry?.data.items ?? [];
---

<BaseLayout
  title="EcoHubs"
  description="EcoHubs — an online-first regenerative community building and applying RCOS, the Regenerative Community Operating System."
>
  <section class="hero">
    <div class="dotted-bg hero-pattern" aria-hidden="true"></div>
    <div class="hero-inner">
      <p class="eyebrow">EcoHubs, applied to itself</p>
      <h1 class="hero-title">
        <span class="text-gradient">Our framework, running on our own community.</span>
      </h1>
      <p class="lede">
        EcoHubs created <strong>RCOS</strong> — the Regenerative Community
        Operating System. This website contains the artifacts produced by
        applying our own framework to our own online community. Not a demo —
        this is the live structure EcoHubs actually runs on, published openly
        to show that RCOS works for online communities and as a worked
        example of how an outcome looks in practice.
      </p>

      <div class="cta-row">
        <a href="/layers" class="btn btn-primary">Explore the RCOS artifacts</a>
        <a
          href="https://rcos.ecohubs.community"
          target="_blank"
          rel="noopener"
          class="btn btn-secondary"
        >
          RCOS framework <span class="arrow">↗</span>
        </a>
        <a
          href="https://ecohubs.community"
          target="_blank"
          rel="noopener"
          class="btn btn-ghost"
        >
          About EcoHubs <span class="arrow">↗</span>
        </a>
        <a
          href="https://github.com/ecohubs-community/RCOS-ecohubs"
          target="_blank"
          rel="noopener"
          class="btn btn-ghost"
        >
          View on GitHub <span class="arrow">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="context-grid">
    <article class="context-card">
      <img
        src="/rcos-blueprint.webp"
        alt=""
        class="card-image"
        loading="lazy"
        width="600"
        height="450"
      />
      <p class="card-eyebrow">What is RCOS?</p>
      <h2>A shared operating system for intentional communities.</h2>
      <p>
        RCOS is an open-source, shared system for organizing intentional
        communities. It gives you clear, ready-to-use structures for
        decision-making, roles, resource sharing, and handling conflicts — so
        you can focus on building your community instead of figuring
        everything out from scratch.
      </p>
      <a
        href="https://rcos.ecohubs.community"
        target="_blank"
        rel="noopener"
        class="card-link"
      >
        Read the standard <span class="arrow">↗</span>
      </a>
    </article>

    <article class="context-card">
      <img
        src="/ecohubs-network.webp"
        alt=""
        class="card-image"
        loading="lazy"
        width="600"
        height="340"
      />
      <p class="card-eyebrow">What is EcoHubs?</p>
      <h2>The community building the RCOS Standard — and living it.</h2>
      <p>
        We are co-creating the world's first open-source standard for
        regenerative communities (RCOS) as one tangible outcome of our work.
        Our primary purpose is to make regenerative community living — rooted
        in care for people, land, and life — structurally accessible,
        resilient, and replicable, reducing humanity's dependency on
        extractive systems one community at a time.
      </p>
     
      <a
        href="https://ecohubs.community"
        target="_blank"
        rel="noopener"
        class="card-link"
      >
        Visit ecohubs.community <span class="arrow">↗</span>
      </a>
    </article>
  </section>

  <DashboardTiles />

  <section id="faq" class="faq-section">
    <h2 class="section-title">Frequently asked</h2>
    <p class="section-sub">What this site is, and how to use it.</p>
    <FAQ client:visible items={faqItems} />
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-primary) 8%, var(--color-surface)) 0%,
      var(--color-surface) 60%,
      color-mix(in srgb, var(--color-accent) 6%, var(--color-surface)) 100%
    );
    overflow: hidden;
    margin-bottom: 2.5rem;
  }

  .hero-pattern {
    position: absolute;
    inset: 0;
  }

  .hero-inner {
    position: relative;
    padding: 3.5rem 2rem 3rem;
    max-width: 44rem;
    margin: 0 auto;
    text-align: center;
  }

  @media (max-width: 640px) {
    .hero-inner {
      padding: 2.5rem 1.25rem 2rem;
    }
  }
  @media (max-width: 500px) {
    .cta-row {
      flex-direction: column;
      align-items: stretch;
    }
    .cta-row .btn {
      justify-content: center;
    }
  }

  .eyebrow {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
    font-weight: 500;
    margin: 0 0 1.25rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.1rem, 5vw, 3.2rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 600;
    margin: 0 0 1.25rem;
  }

  .lede {
    font-size: var(--text-lede);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 2rem;
  }

  .cta-row {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
    margin: 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 1.15rem;
    border-radius: var(--radius);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid transparent;
    transition: all 180ms ease;
  }
  .btn-primary {
    background: var(--color-primary);
    color: white;
    box-shadow: 0 2px 8px -2px color-mix(in srgb, var(--color-primary) 40%, transparent);
  }
  .btn-primary:hover {
    background: var(--color-primary-hover);
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px -4px color-mix(in srgb, var(--color-primary) 50%, transparent);
  }
  .btn-secondary {
    border-color: var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
  }
  .btn-secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    transform: translateY(-1px);
  }
  .btn-ghost {
    color: var(--color-text-muted);
  }
  .btn-ghost:hover {
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 7%, transparent);
  }
  .arrow {
    font-size: 0.85em;
    line-height: 1;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 1.9rem;
    font-weight: 600;
    color: var(--color-primary-dark);
    margin: 0 0 0.35rem;
    letter-spacing: -0.01em;
  }
  @media (prefers-color-scheme: dark) {
    .section-title { color: var(--color-primary); }
  }
  .section-sub {
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
  }

  .faq-section {
    margin-top: 3rem;
    max-width: var(--content-max-width);
    scroll-margin-top: 1rem;
  }

  .context-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0 0 3rem;
  }
  @media (max-width: 820px) {
    .context-grid {
      grid-template-columns: 1fr;
    }
  }
  .context-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    box-shadow: var(--shadow-sm);
  }
  .card-image {
    display: block;
    width: 100%;
    height: 160px;
    object-fit: cover;
    border-radius: var(--radius);
    margin: -0.25rem 0 0.25rem;
  }
  @media (max-width: 640px) {
    .context-card {
      padding: 1.1rem;
    }
    .context-card h2 {
      font-size: 1.2rem;
    }
    .card-image {
      height: 120px;
    }
  }
  .card-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
    font-weight: 600;
    margin: 0;
  }
  .context-card h2 {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-primary-dark);
    margin: 0;
  }
  @media (prefers-color-scheme: dark) {
    .context-card h2 { color: var(--color-primary); }
  }
  .context-card p {
    margin: 0;
    line-height: 1.65;
    color: var(--color-text);
  }
  .secondary-label {
    color: var(--color-text-muted) !important;
    font-size: 0.92rem;
    margin-top: 0.25rem !important;
  }
  .secondary-purposes {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .secondary-purposes li::marker {
    color: var(--color-primary);
    font-weight: 600;
  }
  .card-link {
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-primary);
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .card-link:hover {
    color: var(--color-primary-hover);
  }
</style>
